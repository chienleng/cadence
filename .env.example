# Optional data location. Defaults to cadence-workspace beside this checkout.
# The CLI does not load this file. Export CADENCE_DATA_ROOT in your shell
# when running validate, context or refresh; see docs/commands.md.
CADENCE_DATA_ROOT=/Users/you/Documents/Code/cadence-workspace

# Optional. When set, `pnpm refresh` asks Jev (TypeSafe) to judge each STATUS.md
# and caches the answers; `pnpm context` and the app only read the cache.
# Export it in your shell like CADENCE_DATA_ROOT; the CLI does not load this file.
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
